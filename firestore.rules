rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function orderDoc(orderId) { return get(/databases/$(database)/documents/orders/$(orderId)); }
    function canAccessOrder(orderId) {
      let o = orderDoc(orderId).data;
      return signedIn() && (isAdmin() || o.buyerUid == request.auth.uid || o.sellerUid == request.auth.uid);
    }
    function canAccessSupport(threadId) {
      let s = get(/databases/$(database)/documents/support/$(threadId)).data;
      return signedIn() && (isAdmin() || s.uid == request.auth.uid);
    }

    match /gigs/{gigId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title','seller','sellerUid','cat','catLabel','price','delivery','color','tag','desc','packs','imageUrl','imagePath','status','createdAt','updatedAt'])
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.status == 'active'
        && request.resource.data.tag == 'New'
        && request.resource.data.packs is list
        && request.resource.data.packs.size() == 3;
      allow update: if isAdmin() || (signedIn()
        && resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title','seller','cat','catLabel','price','delivery','color','tag','desc','packs',
          'imageUrl','imagePath','updatedAt'
        ]));
      allow delete: if isAdmin() || (signedIn() && resource.data.sellerUid == request.auth.uid);
    }

    // Orders and money movements are written only by trusted Cloud Functions.
    match /orders/{orderId} {
      allow get, list: if isAdmin() || (signedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid));
      allow create, update, delete: if false;
    }
    match /paymentTransactions/{transactionId} { allow read, write: if false; }
    match /wallets/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /ledger/{entryId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow write: if false;
    }
    match /payouts/{payoutId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['bkash','nagad','accountName','name','email','updatedAt']);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bkash','nagad','accountName','name','email','updatedAt']);
      allow delete: if false;
    }
    match /notifications/{notificationId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;
      allow create, delete: if false;
    }
    match /support/{threadId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.message is string;
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && ((request.resource.data.kind == 'order' && canAccessOrder(request.resource.data.threadId))
          || (request.resource.data.kind == 'support' && canAccessSupport(request.resource.data.threadId)));
      allow get, list: if isAdmin()
        || (resource.data.kind == 'order' && canAccessOrder(resource.data.threadId))
        || (resource.data.kind == 'support' && canAccessSupport(resource.data.threadId));
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow get: if settingId == 'payments' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /adminUsers/{uid} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
  }
}
